{
  "name": "shotpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "拉片工作台：自动切分镜、结构化标注、复刻参考镜头，并用复刻出的模板一键出片",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "analyze": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json",
    "replica": "tsx src/replica-cli.ts",
    "compare": "tsx src/compare-cli.ts",
    "build:templates": "tsx scripts/build-templates.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.527",
    "@remotion/player": "4.0.527",
    "@remotion/renderer": "4.0.527",
    "@remotion/zod-types": "4.0.527",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.527",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
